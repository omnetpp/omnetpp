%description:
Test ensureDescriptor<T>() with dynamic descriptors for primitive types and std::vector

%file: test.ned

simple Tester
{
}

network Test
{
    submodules:
        tester: Tester;
}

%file: test.msg
namespace @TESTNAME@;

struct Point {
    double x;
    double y;
}

%file: test.cc

#include <omnetpp.h>
#include <list>
#include <set>
#include <map>
#include <unordered_map>
#include "../lib/descriptortest.h"
#include "test_m.h"

using namespace omnetpp;

namespace @TESTNAME@ {

class Tester : public cSimpleModule
{
  public:
    Tester() : cSimpleModule(32768) { }
    virtual void activity() override;
};

Define_Module(Tester);

void Tester::activity()
{
    // --- Primitive types ---
    int intVal = 42;
    cClassDescriptor *intDesc = omnetpp::ensureDescriptor<int>();
    EV << "=== int ===\n";
    testlib::printDescriptor(EV, any_ptr(&intVal), intDesc);

    double dblVal = 3.14;
    cClassDescriptor *dblDesc = omnetpp::ensureDescriptor<double>();
    EV << "=== double ===\n";
    testlib::printDescriptor(EV, any_ptr(&dblVal), dblDesc);

    bool boolVal = true;
    cClassDescriptor *boolDesc = omnetpp::ensureDescriptor<bool>();
    EV << "=== bool ===\n";
    testlib::printDescriptor(EV, any_ptr(&boolVal), boolDesc);

    std::string strVal = "hello world";
    cClassDescriptor *strDesc = omnetpp::ensureDescriptor<std::string>();
    EV << "=== std::string ===\n";
    testlib::printDescriptor(EV, any_ptr(&strVal), strDesc);

    long longVal = 123456789L;
    cClassDescriptor *longDesc = omnetpp::ensureDescriptor<long>();
    EV << "=== long ===\n";
    testlib::printDescriptor(EV, any_ptr(&longVal), longDesc);

    char charVal = 'A';
    cClassDescriptor *charDesc = omnetpp::ensureDescriptor<char>();
    EV << "=== char ===\n";
    testlib::printDescriptor(EV, any_ptr(&charVal), charDesc);

    short shortVal = 1234;
    cClassDescriptor *shortDesc = omnetpp::ensureDescriptor<short>();
    EV << "=== short ===\n";
    testlib::printDescriptor(EV, any_ptr(&shortVal), shortDesc);

    // --- cMessage (already has a registered descriptor) ---
    cMessage msg("hello");
    cClassDescriptor *msgDesc = omnetpp::ensureDescriptor<cMessage>();
    EV << "=== cMessage ===\n";
    testlib::printDescriptor(EV, toAnyPtr(&msg), msgDesc);

    // --- msg-file defined struct ---
    Point pt;
    pt.x = 1.5;
    pt.y = 2.5;
    cClassDescriptor *ptDesc = omnetpp::ensureDescriptor<Point>();
    EV << "=== Point ===\n";
    testlib::printDescriptor(EV, toAnyPtr(&pt), ptDesc);

    // --- Test setValueAsString on primitive ---
    EV << "=== int: setValueAsString ===\n";
    intDesc->setValueAsString(any_ptr(&intVal), "99");
    EV << "after set: " << intVal << "\n\n";

    dblDesc->setValueAsString(any_ptr(&dblVal), "2.718");
    EV << "=== double: setValueAsString ===\n";
    EV << "after set: " << dblVal << "\n\n";

    // --- Test that looking up same type returns same descriptor ---
    EV << "=== descriptor identity ===\n";
    EV << "same int desc: " << (omnetpp::ensureDescriptor<int>() == intDesc ? "true" : "false") << "\n\n";

    // --- std::vector<int> ---
    std::vector<int> intVec = {10, 20, 30};
    cClassDescriptor *intVecDesc = omnetpp::ensureDescriptor<std::vector<int>>();
    EV << "=== std::vector<int> ===\n";
    testlib::printDescriptor(EV, any_ptr(&intVec), intVecDesc);

    // --- std::vector<double> ---
    std::vector<double> dblVec = {1.1, 2.2, 3.3};
    cClassDescriptor *dblVecDesc = omnetpp::ensureDescriptor<std::vector<double>>();
    EV << "=== std::vector<double> ===\n";
    testlib::printDescriptor(EV, any_ptr(&dblVec), dblVecDesc);

    // --- std::vector<std::string> ---
    std::vector<std::string> strVec = {"alpha", "beta", "gamma"};
    cClassDescriptor *strVecDesc = omnetpp::ensureDescriptor<std::vector<std::string>>();
    EV << "=== std::vector<std::string> ===\n";
    testlib::printDescriptor(EV, any_ptr(&strVec), strVecDesc);

    // --- empty vector ---
    std::vector<int> emptyVec;
    EV << "=== empty std::vector<int> ===\n";
    testlib::printDescriptor(EV, any_ptr(&emptyVec), intVecDesc);

    // --- nested std::vector<std::vector<int>> ---
    std::vector<std::vector<int>> nestedVec = {{1, 2}, {3, 4, 5}};
    cClassDescriptor *nestedVecDesc = omnetpp::ensureDescriptor<std::vector<std::vector<int>>>();
    EV << "=== std::vector<std::vector<int>> ===\n";
    testlib::printDescriptor(EV, any_ptr(&nestedVec), nestedVecDesc);

    // --- setFieldValueAsString on vector element ---
    EV << "=== std::vector<int>: setFieldValueAsString ===\n";
    intVecDesc->setFieldValueAsString(any_ptr(&intVec), 0, 1, "77");
    EV << "after set [1]: ";
    for (int x : intVec) EV << x << " ";
    EV << "\n\n";

    // --- std::list<int> ---
    std::list<int> intList = {100, 200, 300};
    cClassDescriptor *intListDesc = omnetpp::ensureDescriptor<std::list<int>>();
    EV << "=== std::list<int> ===\n";
    testlib::printDescriptor(EV, any_ptr(&intList), intListDesc);

    // --- std::set<int> ---
    std::set<int> intSet = {5, 10, 15, 20};
    cClassDescriptor *intSetDesc = omnetpp::ensureDescriptor<std::set<int>>();
    EV << "=== std::set<int> ===\n";
    testlib::printDescriptor(EV, any_ptr(&intSet), intSetDesc);

    // --- std::set<std::string> ---
    std::set<std::string> strSet = {"apple", "banana", "cherry"};
    cClassDescriptor *strSetDesc = omnetpp::ensureDescriptor<std::set<std::string>>();
    EV << "=== std::set<std::string> ===\n";
    testlib::printDescriptor(EV, any_ptr(&strSet), strSetDesc);

    // --- std::map<std::string, int> ---
    std::map<std::string, int> strIntMap = {{"one", 1}, {"two", 2}, {"three", 3}};
    cClassDescriptor *strIntMapDesc = omnetpp::ensureDescriptor<std::map<std::string, int>>();
    EV << "=== std::map<std::string,int> ===\n";
    testlib::printDescriptor(EV, any_ptr(&strIntMap), strIntMapDesc);

    // --- std::map<int, std::string> ---
    std::map<int, std::string> intStrMap = {{1, "one"}, {2, "two"}};
    cClassDescriptor *intStrMapDesc = omnetpp::ensureDescriptor<std::map<int, std::string>>();
    EV << "=== std::map<int,std::string> ===\n";
    testlib::printDescriptor(EV, any_ptr(&intStrMap), intStrMapDesc);

    // --- std::unordered_map<std::string, double> ---
    std::unordered_map<std::string, double> strDblUMap;
    strDblUMap["pi"] = 3.14;
    cClassDescriptor *strDblUMapDesc = omnetpp::ensureDescriptor<std::unordered_map<std::string, double>>();
    EV << "=== std::unordered_map<std::string,double> ===\n";
    testlib::printDescriptor(EV, any_ptr(&strDblUMap), strDblUMapDesc);

    // --- nested: std::map<std::string, std::vector<int>> ---
    std::map<std::string, std::vector<int>> mapOfVec;
    mapOfVec["alpha"] = {10, 20};
    mapOfVec["beta"] = {30, 40, 50};
    cClassDescriptor *mapOfVecDesc = omnetpp::ensureDescriptor<std::map<std::string, std::vector<int>>>();
    EV << "=== std::map<std::string,std::vector<int>> ===\n";
    testlib::printDescriptor(EV, any_ptr(&mapOfVec), mapOfVecDesc);

    // --- nested: std::vector<std::map<std::string, int>> ---
    std::vector<std::map<std::string, int>> vecOfMap;
    vecOfMap.push_back({{"x", 1}, {"y", 2}});
    vecOfMap.push_back({{"z", 3}});
    cClassDescriptor *vecOfMapDesc = omnetpp::ensureDescriptor<std::vector<std::map<std::string, int>>>();
    EV << "=== std::vector<std::map<std::string,int>> ===\n";
    testlib::printDescriptor(EV, any_ptr(&vecOfMap), vecOfMapDesc);

    // --- nested: std::map<std::string, std::map<std::string, int>> ---
    std::map<std::string, std::map<std::string, int>> mapOfMap;
    mapOfMap["outer1"] = {{"a", 1}, {"b", 2}};
    mapOfMap["outer2"] = {{"c", 3}};
    cClassDescriptor *mapOfMapDesc = omnetpp::ensureDescriptor<std::map<std::string, std::map<std::string, int>>>();
    EV << "=== std::map<std::string,std::map<std::string,int>> ===\n";
    testlib::printDescriptor(EV, any_ptr(&mapOfMap), mapOfMapDesc);

    // --- std::pair<std::string, int> ---
    std::pair<std::string, int> strIntPair = {"hello", 42};
    cClassDescriptor *strIntPairDesc = omnetpp::ensureDescriptor<std::pair<std::string, int>>();
    EV << "=== std::pair<std::string,int> ===\n";
    testlib::printDescriptor(EV, any_ptr(&strIntPair), strIntPairDesc);

    // --- std::pair<int, std::vector<int>> ---
    std::pair<int, std::vector<int>> intVecPair = {99, {1, 2, 3}};
    cClassDescriptor *intVecPairDesc = omnetpp::ensureDescriptor<std::pair<int, std::vector<int>>>();
    EV << "=== std::pair<int,std::vector<int>> ===\n";
    testlib::printDescriptor(EV, any_ptr(&intVecPair), intVecPairDesc);

    // --- std::vector<std::pair<std::string, int>> ---
    std::vector<std::pair<std::string, int>> vecOfPair = {{"x", 10}, {"y", 20}};
    cClassDescriptor *vecOfPairDesc = omnetpp::ensureDescriptor<std::vector<std::pair<std::string, int>>>();
    EV << "=== std::vector<std::pair<std::string,int>> ===\n";
    testlib::printDescriptor(EV, any_ptr(&vecOfPair), vecOfPairDesc);

    // --- nested: std::list<std::set<int>> ---
    std::list<std::set<int>> listOfSet;
    listOfSet.push_back({1, 2, 3});
    listOfSet.push_back({4, 5});
    cClassDescriptor *listOfSetDesc = omnetpp::ensureDescriptor<std::list<std::set<int>>>();
    EV << "=== std::list<std::set<int>> ===\n";
    testlib::printDescriptor(EV, any_ptr(&listOfSet), listOfSetDesc);

    EV << ".\n";
}

} // namespace

