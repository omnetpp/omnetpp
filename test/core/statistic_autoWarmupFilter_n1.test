%description:
Tests that an invalid autoWarmupFilter value is reported with the name of the key,
the statistic and the module.

%file: test.ned

module Node
{
    @statistic[a](record=mean;autoWarmupFilter=maybe);
}

network Test
{
    submodules:
        node: Node;
}

%inifile: test.ini
[General]
network = Test

%exitcode: 1

%contains: stderr
Cannot add statistic 'a' to module Test.node (NED type: Node): Invalid value 'maybe' for autoWarmupFilter attribute, expecting 'true' or 'false'
