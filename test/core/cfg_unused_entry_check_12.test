%description:
unused-entry-check-time = initialization: if the run later stops with an error,
the unused entries are not reported again.

%file: test.ned

simple App
{
    parameters:
        int p = default(0);
}

network Test
{
    submodules:
        app: App;
}

%file: test.cc

#include <omnetpp.h>

using namespace omnetpp;

namespace @TESTNAME@ {

class App : public cSimpleModule
{
  protected:
    virtual void initialize() override {
        scheduleAt(1, new cMessage("timer"));
    }
    virtual void handleMessage(cMessage *msg) override {
        delete msg;
        throw cRuntimeError("Failed in handleMessage");
    }
};

Define_Module(App);

}

%inifile: test.ini
[General]
unused-entry-check-time = initialization
**.app.p = 1
**.app.stale = 2

%exitcode: 1

%contains-regex: stderr
(?s)<!> Warning: 1 configuration entry has had no effect in this run .*
  \*\*\.app\.stale = 2  -- .*test\.ini:4
.*<!> Error: Failed in handleMessage

%not-contains: stderr
before the run stopped
