%description:
unused-entry-check: entries for a module created during the simulation are
not reported when checking at the end of the run.

%file: test.ned

module Dynamic
{
    parameters:
        int p = default(0);
}

simple Creator
{
}

network Test
{
    submodules:
        creator: Creator;
}

%file: test.cc

#include <omnetpp.h>

using namespace omnetpp;

namespace @TESTNAME@ {

class Creator : public cSimpleModule
{
  protected:
    virtual void initialize() override {
        scheduleAt(1, new cMessage("create"));
    }
    virtual void handleMessage(cMessage *msg) override {
        delete msg;
        cModule *module = cModuleType::get("Dynamic")->createScheduleInit("dynamic", getParentModule());
        EV << "created, p=" << module->par("p").intValue() << "\n";
    }
};

Define_Module(Creator);

}

%inifile: test.ini
[General]
unused-entry-check = error
**.dynamic.p = 5

%contains: stdout
created, p=5

%contains: stdout
Calling finish() at end of Run #0...
