%description:
unused-entry-check = error: when the check itself fails the run, the unused
entries are reported only once, as the error.

%file: test.ned

simple App
{
    parameters:
        int p = default(0);
}

network Test
{
    submodules:
        app: App;
}

%file: test.cc

#include <omnetpp.h>

using namespace omnetpp;

namespace @TESTNAME@ {

class App : public cSimpleModule
{
  protected:
    virtual void initialize() override {
        scheduleAt(1, new cMessage("timer"));
    }
    virtual void handleMessage(cMessage *msg) override {
        delete msg;
    }
};

Define_Module(App);

}

%inifile: test.ini
[General]
unused-entry-check = error
**.app.p = 1
**.app.stale = 2

%exitcode: 1

%contains-regex: stderr
<!> Error: 1 configuration entry had no effect in this run .*
  \*\*\.app\.stale = 2  -- .*test\.ini:4

%not-contains: stderr
before the run stopped
