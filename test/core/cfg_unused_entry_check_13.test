%description:
unused-entry-check = off: nothing is reported if the run stops with an error.

%file: test.ned

simple App
{
    parameters:
        int p = default(0);
}

network Test
{
    submodules:
        app: App;
}

%file: test.cc

#include <omnetpp.h>

using namespace omnetpp;

namespace @TESTNAME@ {

class App : public cSimpleModule
{
  protected:
    virtual void initialize() override {
        scheduleAt(1, new cMessage("timer"));
    }
    virtual void handleMessage(cMessage *msg) override {
        delete msg;
        throw cRuntimeError("Failed in handleMessage");
    }
};

Define_Module(App);

}

%inifile: test.ini
[General]
unused-entry-check = off
**.app.p = 1
**.app.stale = 2

%exitcode: 1

%contains: stderr
Failed in handleMessage

%not-contains: stderr
configuration entr
