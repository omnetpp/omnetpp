%description:
unused-entry-check: if the run stops with an error, the entries that have had
no effect until then are reported as a warning, after the error message.

%file: test.ned

simple App
{
    parameters:
        int p = default(0);
}

network Test
{
    submodules:
        app: App;
}

%file: test.cc

#include <omnetpp.h>

using namespace omnetpp;

namespace @TESTNAME@ {

class App : public cSimpleModule
{
  protected:
    virtual void initialize() override {
        scheduleAt(1, new cMessage("timer"));
    }
    virtual void handleMessage(cMessage *msg) override {
        delete msg;
        throw cRuntimeError("Failed in handleMessage");
    }
};

Define_Module(App);

}

%inifile: test.ini
[General]
**.app.p = 1
**.app.stale = 2

%exitcode: 1

%contains-regex: stderr
(?s)<!> Error: Failed in handleMessage.*<!> Warning: 1 configuration entry had no effect before the run stopped \(see the unused-entry-check option\):
  \*\*\.app\.stale = 2  -- .*test\.ini:3
Possible causes: .*, or for a module created later during the simulation
