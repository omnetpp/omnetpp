#!/usr/bin/env bash
#
# OMNeT++ environment setter
#
# This script sets all the required environment variables so
# OMNeT++ tools can be executed. It can be either sourced or executed:
#
# Executing:
# './setenv <command>' starts the command in a properly set up environment
# (e.g. './setenv opp_ide' or './setenv opp_run' or './setenv bash'
# to start an interactive shell)
#
# Sourcing:
# 'source setenv' or '. setenv' configures the current shell
#
# When sourcing, the first argument can be (e.g. 'source setenv -q'):
# -q : do not show banner text on configuration success
# -r : remove an already configured environment

# Get the directory where this script reside using a trick (works differently on bash and zsh)
# On bash, the current script's name is in 'BASH_SOURCE[0]'
if [ "$BASH_VERSION" != "" ]; then # for BASH
  __root_dir=$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)
  if [[ "$BASH_SOURCE" != "$0" ]]; then
    sourced=yes
  fi
elif [ "$ZSH_VERSION" != "" ]; then
  # the script is here is implicitly known to be sourced because the shebang is /usr/bin/env bash
  # so it always executes under bash, not zsh
  __root_dir=$(cd $(dirname $0) && pwd)
  sourced=yes
else # other shells are not supported, because we use variable manipulation constructs that are not part of POSIX
  echo "Error: Unrecognized shell, only 'bash' and 'zsh' are supported."
  return 1
fi

# check if dir is really pointing to an omnet++ installation dir
if [ ! -f "$__root_dir/configure.user" -o ! -f "$__root_dir/include/omnetpp.h" -o ! -f "$__root_dir/Version" ]; then
    echo "Error: '$__root_dir' does not look like an OMNeT++ root directory"
    if [[ "$sourced" == "yes" ]]; then
      return 1
    else
      exit 1
    fi
fi

# handle -q flag (must be the first argument)
if [[ "$1" == "-q" ]]; then
  quiet=true
  shift
else
  quiet=false
fi

# Activate local python virtual environment if present in the root directory.
# You can create a virtual environment with 'python3 -m venv .venv'
# and then install all required packages with 'python3 -m pip install -r python/requirements.txt'
#
# NOTE: the bin/activate script directly sets the PATH variable to a value saved during
# an earlier run of the script to restore the PATH to that state. This may overwrite any
# changes made to the PATH since the last run. Because of this it is EXTREMELY important
# NOT to modify the PATH in the 'setenv' script before activating the virtual env.
# In short, this activation MUST BE at the very beginning of the 'setenv' script.
#
# NOTE: On NixOS we must avoid activating a virtual environment UNLESS we are in an FHS shell
# where all necessary libraries are mapped to their standard locations. Modules (with wheels)
# installed by pip will not work in a standard Nix environment.
#
if [ -f "$__root_dir/.venv/bin/activate" ] ; then
  [[ "$quiet" != "true" ]] && echo "Activating python virtual environment in '$__root_dir/.venv'"
  source $__root_dir/.venv/bin/activate
fi

# Handle special cases for sourcing vs executing this script:
# Sourcing is not allowed on NixOS, and executing ./setenv without arguments is not allowed on non-NixOS systems
# to avoid inadvertedly calling setenv instead of sourcing it.
if [[ "$sourced" == "yes" ]]; then
  # check if we are in a properly configured nix shell and throw error if not
  if [[ -f /etc/NIXOS && "$name" != "opp_shell" ]]; then
    skip_setenv=true
    eval "$(nix print-dev-env --extra-experimental-features nix-command --extra-experimental-features flakes $__root_dir/.opp_shell)"
    unset skip_setenv
  fi
else
  # we have executed setenv so we need at least 1 explicit parameter as a command to be executed
  if [[ $# == 0 ]]; then
    echo "Error: Use 'setenv <command>' to execute a command or make sure to source this script as 'source setenv' or '. setenv' to set up your current shell, otherwise its settings won't take effect."
    exit 1
  fi
  if [[ -f /etc/NIXOS ]]; then
    # setenv was executed on NixOS so we invoke a properly configured develoment shell to install all dependencies
    # to their standard locations. setenv will be sourced in the shellHook
    exec nix develop --extra-experimental-features nix-command --extra-experimental-features flakes "$__root_dir/.opp_shell" -c -- "$@"
    # implicit exit because of exec
  else
    source "$__root_dir/setenv" && exec "$@"
    # implicit exit
  fi
fi

# check for HOMEBREW (on macOS) environment and activate dependent packages
# (Unless we are in a nix shell... In that case the environment should already be set up
# and brew should not be used at all)
if [ "$(uname)" = "Darwin" -a "$(command -v brew)" != "" -a -z "$IN_NIX_SHELL" ]; then
  [[ "$quiet" != "true" ]] && echo "HOMEBREW detected, activating dependencies (qt@6, bison, flex, pkg-config, make)."
  export PATH="$(brew --prefix llvm)/bin:$PATH"
  export PATH="$(brew --prefix qt@6)/bin:$PATH"
  export PATH="$(brew --prefix bison)/bin:$PATH"
  export PATH="$(brew --prefix flex)/bin:$PATH"
  export PATH="$(brew --prefix pkg-config)/bin:$PATH"
  export PATH="$(brew --prefix make)/libexec/gnubin:$PATH"
  export LDFLAGS="-L$(brew --prefix)/lib $LDFLAGS"
  export CFLAGS="-isystem $(brew --prefix)/include $CFLAGS"
fi

function _numargs() { echo $#; }
if [ $(_numargs $__root_dir) -gt 1 ]; then
    echo "Error: Directory name ($__root_dir) must not contain spaces or special characters."
    return 1
fi

# utility functions for path manipulation
opp_path_remove()
{
    [[ -z $2 ]] && return 2
    local value=":$1:"
    value=${value//:$2:/:}
    value=${value#:}
    value=${value%:}
    echo $value
}

opp_path_cleanup()
{
    for varname in "$@"; do
      local value=$(eval echo \$$varname)  # note: we use eval because '${!varname}' works only in bash, and '${(P)varname}' works only in zsh
      while [[ $value == *::* ]] ; do
          value=${value//::/:}
      done
      value=${value#:}
      value=${value%:}
      export $varname="$value"
    done
}

# remove previous environment to prevent the accumulation of path elements
if [ -n "$__omnetpp_root_dir" ]; then
  if [ "$1" = "-r" ]; then
    [[ "$quiet" != "true" ]] && echo "Removed previous environment for '$__omnetpp_root_dir'."
    dir=
  else
    [[ "$quiet" != "true" ]] && echo "Warning: overwriting previous environment for '$__omnetpp_root_dir'."
  fi
  export PATH=$(opp_path_remove "$PATH" "$__omnetpp_root_dir/bin")
  export PYTHONPATH=$(opp_path_remove "$PYTHONPATH" "$__omnetpp_root_dir/python")
  export OMNETPP_IMAGE_PATH=$(opp_path_remove "$OMNETPP_IMAGE_PATH" "$__omnetpp_root_dir/images")
  export __omnetpp_root_dir=
  export OMNETPP_RELEASE=
  export QT_SELECT=
  export QT_LOGGING_RULES=
fi

# do not continue if removal was requested
if [ "$1" = "-r" ]; then
    return 0
fi

# macOS specific settings
if [ $(uname) = "Darwin" ]; then
  if [ $(uname -m) = "arm64" ]; then
    if [ -d $__root_dir/tools/macos.x86_64 ]; then
      echo "NOTE: We are running on Apple Silicon, but you have downloaded the x86_64 version of the installation package!"
      echo "Turning on x86_64 emulation by starting a new shell with 'arch -x86_64 /bin/zsh -i' ..."
      export $__root_dir; arch -x86_64 /bin/zsh -c 'source $__root_dir/setenv; zsh -i'
      return 1
    fi
    if [ -d $__root_dir/tools/macos.aarch64 ]; then
      TOOLS_DIR=$__root_dir/tools/macos.aarch64
      export PATH=$TOOLS_DIR/bin:$PATH
    fi
  else
    if [ -d $__root_dir/tools/macos.x86_64 ]; then
      TOOLS_DIR=$__root_dir/tools/macos.x86_64
      export PATH=$TOOLS_DIR/bin:$PATH
    fi
  fi
fi


if [ -n "$MSYSTEM" ]; then
  # on Windows MinGW, we need to unset PYTHONPATH to prevent it from being polluted by external python installations
  # especially the ones that use windows style path separators (e.g. C:\Python312\Lib\site-packages)
  export PYTHONPATH=
fi

# Windows/MinGW specific settings for MS ABI compatible build
if [ -n "$MSYSTEM" -a "$MS_ABI" = "yes" ] ; then
  if [ -n "$VCToolsInstallDir" ] ; then
    # add the MS toolchain directories at the beginning of the PATH to hide the default clang compiler
    export PATH=$(cygpath "$VCToolsInstallDir/bin/HostX64/x64"):$(cygpath "$VCINSTALLDIR/Tools/Llvm/x64/bin"):$(cygpath "$VCPKG_ROOT"):$PATH
  else
    echo "Error: MS Visual C++ and Clang installation is required."
  fi
  # dependencies installed from VCPKG
  VCPKGTripletDir=/opt/visualc
  if [ -d $VCPKGTripletDir ] ; then
    export PATH=$(cygpath "$VCPKGTripletDir/bin"):$(cygpath "$VCPKGTripletDir/tools/Qt6/bin"):$PATH
    export OSG_LIBRARY_PATH=$VCPKGTripletDir/plugins
  else
    echo "Error: The /opt/visualc directory must contain the dependencies insalled by 'vcpkg'. See the 'install_vcenv.sh' file for details."
  fi
fi

export PATH="$__root_dir/bin:$PATH"
export PYTHONPATH="$__root_dir/python:$PYTHONPATH"
export OMNETPP_IMAGE_PATH="$__root_dir/images:$OMNETPP_IMAGE_PATH"
export HOSTNAME
export HOST
export QT_SELECT=6 # on systems with qtchooser, switch to Qt6
export QT_LOGGING_RULES='*.warning=false;qt.qpa.*=false' # disable some qt logging

export OMNETPP_RELEASE=$(cat $__root_dir/Version)
export __omnetpp_root_dir=$__root_dir
unset __root_dir

if [[ "$quiet" != "true" ]]; then
  echo "Environment for '$OMNETPP_RELEASE' in directory '$__omnetpp_root_dir' is ready."

  if [ ! -f $__omnetpp_root_dir/Makefile.inc ]; then
    cat <<__END__

Type "./configure" and "make" to build the simulation libraries.
When done, type "omnetpp" to start the IDE.
__END__
  fi
fi

# source user specific script if present
if [ -f "$__omnetpp_root_dir/setenv_local" ] ; then
  source $__omnetpp_root_dir/setenv_local
fi

# Mingw doesn't like extra colons in paths, so remove them using a shell function
opp_path_cleanup PATH PYTHONPATH OMNETPP_IMAGE_PATH
