# OMNeT++ documentation builder image.
#
# Contains the complete toolchain to build the unified Sphinx documentation site
# (manual + guides + doxygen APIs + Python API): doxygen, graphviz, a pinned pandoc
# for the manual LaTeX->RST conversion, and the Python Sphinx stack from the pinned
# uv.lock. Math is rendered client-side by KaTeX, so no LaTeX/texlive is needed.
# It also carries the OMNeT++ command-line tools (opp_docgen, opp_lint, opp_lsp,
# opp_ide_mcp) so the image can generate NED documentation, e.g. as the base of a
# model library's (INET's) documentation build.
#
# Two images are built from this file (build.sh always passes --target):
#   base  the HTML toolchain above            -> ghcr.io/omnetpp/doc-builder:latest
#   pdf   base + TeX Live, ImageMagick and     -> ghcr.io/omnetpp/doc-builder:latest-pdf
#         rsvg-convert for the PDF targets (Sphinx latexpdf, the manual's pdflatex)
#
# The Python packages are installed with uv into a venv that is on PATH, so the
# build runs WITHOUT uv inside the container:
#     make -C doc/src ci-html PIPRUN= VENVDEP= VERSION=6.x
#
# Build context must be doc/src (so pyproject.toml/uv.lock are available), and
# site/doc-builder/opp-tools.tgz must hold the opp-tools npm tarball. build.sh
# stages that file, so use it rather than invoking podman directly:
#     site/doc-builder/build.sh
#
# Size notes (kept lean on purpose):
#   - doxygen is the official static binary, NOT the apt package, because the
#     latter hard-depends on libclang/LLVM (~216 MB) that our doxyfiles never use.
#   - No LaTeX/texlive in base: HTML math is rendered client-side by KaTeX
#     (sphinxcontrib.katex). TeX Live (~0.5-1 GB) lives only in the pdf image, so
#     HTML-only deploys do not pull it.
#
# The platform is pinned: every tool below is fetched as an x86_64/amd64 binary,
# so building on an arm64 host without this would produce a broken image.
FROM --platform=linux/amd64 docker.io/library/ubuntu:26.04 AS base

# org.opencontainers.image.source is what makes GHCR link the published package to
# the repository, which in turn lets a workflow's GITHUB_TOKEN pull it. It is NOT
# set here on purpose: it must name the repository that actually publishes the
# image, so build.sh and doc-builder-image.yml pass it with --label at build time.
LABEL org.opencontainers.image.description="Toolchain for building the OMNeT++ documentation site" \
      org.opencontainers.image.licenses="LGPL-3.0-or-later"

ENV DEBIAN_FRONTEND=noninteractive

# System toolchain. graphviz renders the manual's .dot figures to SVG.
RUN apt-get update && apt-get install -y --no-install-recommends \
        graphviz \
        nodejs \
        python3 \
        make \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* /var/log/* /var/cache/* /usr/share/doc/* /usr/share/man/*

# Doxygen: official binary release (no libclang dependency, unlike the apt package).
# NOT the absolute latest: doxygen >=1.15 emits modern relative-color CSS
# (hsl(from ...)) that doxysphinx's (deprecated, frozen) LibSass scoper cannot
# parse. 1.14.0 is the newest release that works with the current doxysphinx.
ARG DOXYGEN_VERSION=1.14.0
RUN set -eu; \
    tag="Release_$(echo "$DOXYGEN_VERSION" | tr . _)"; \
    curl -fsSL -o /tmp/doxygen.tgz \
        "https://github.com/doxygen/doxygen/releases/download/${tag}/doxygen-${DOXYGEN_VERSION}.linux.bin.tar.gz"; \
    tar -xzf /tmp/doxygen.tgz -C /tmp; \
    install -m0755 "/tmp/doxygen-${DOXYGEN_VERSION}/bin/doxygen" /usr/local/bin/doxygen; \
    rm -rf /tmp/doxygen.tgz "/tmp/doxygen-${DOXYGEN_VERSION}"; \
    doxygen --version   # fail the build early if the binary can't run

# Pandoc: drives the manual LaTeX->RST conversion (doc/src/manual/tools/tex2rst).
# Pinned for reproducibility (the converter is version-sensitive).
ARG PANDOC_VERSION=3.10
RUN curl -fsSL -o /tmp/pandoc.deb \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-amd64.deb" \
    && dpkg -i /tmp/pandoc.deb \
    && rm -f /tmp/pandoc.deb

# Python Sphinx toolchain, installed with uv from the pinned uv.lock into a venv
# that is on PATH (so the build needs neither uv nor pip at run time inside the
# container). uv is only needed at build time, so it is fetched and removed within
# this single layer; nothing extra persists in the image. Caches/bytecode stripped.
# Build the venv against a uv-managed CPython 3.12 rather than the base image's
# system Python: doxysphinx caps lxml at <=5.2.1, which has no wheel for newer
# Python, and we don't want a C toolchain in the image to compile it. The system
# python3 is still used for the stdlib-only helper scripts (tex2rst etc.).
ENV UV_PROJECT_ENVIRONMENT=/opt/docvenv \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON=3.12 \
    UV_PYTHON_DOWNLOADS=automatic
COPY pyproject.toml uv.lock /opt/docproj/
ARG UV_VERSION=0.11.8
RUN curl -fsSL -o /tmp/uv.tar.gz \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    && tar -xzf /tmp/uv.tar.gz -C /tmp \
    && (cd /opt/docproj && /tmp/uv-x86_64-unknown-linux-gnu/uv sync --frozen --no-dev --no-cache) \
    && find /opt/docvenv -type d -name '__pycache__' -prune -exec rm -rf {} + \
    && find /opt/docvenv -type f -name '*.pyc' -delete \
    && rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu /opt/docproj ~/.cache
ENV PATH="/opt/docvenv/bin:$PATH" VIRTUAL_ENV=/opt/docvenv

# OMNeT++ command-line tools from the @omnetpp/opp-tools npm package (built in the
# omnetpp-vscode repo). Its bundles are self-contained, so no npm is needed: the
# tarball is bind-mounted (leaving no layer behind), unpacked, and its bins linked
# onto PATH. Kept late in the file because it changes more often than the layers
# above. The smoke check fails the build if opp_docgen cannot generate output.
RUN --mount=type=bind,source=site/doc-builder/opp-tools.tgz,target=/tmp/opp-tools.tgz \
    set -eu; \
    mkdir -p /opt/opp-tools; \
    tar -xzf /tmp/opp-tools.tgz -C /opt/opp-tools --strip-components=1 --no-same-owner; \
    for tool in opp_docgen opp_lint opp_lsp opp_ide_mcp; do \
        chmod 0755 "/opt/opp-tools/dist/$tool.js"; \
        ln -s "/opt/opp-tools/dist/$tool.js" "/usr/local/bin/$tool"; \
    done; \
    opp_docgen --version; \
    opp_lint --version; \
    mkdir -p /tmp/smoke/src; \
    printf '//\n// Smoke-test module.\n//\nsimple Smoke\n{\n}\n' > /tmp/smoke/src/Smoke.ned; \
    opp_docgen --format=rst -o /tmp/smoke/out /tmp/smoke/src; \
    grep -rq 'Smoke-test module' /tmp/smoke/out; \
    opp_lint /tmp/smoke/src; \
    rm -rf /tmp/smoke

# git refuses to operate on repos owned by another uid (bind-mounted host repo).
RUN git config --system --add safe.directory '*'

WORKDIR /work
CMD ["bash"]

# PDF variant. TeX Live is the Ubuntu packaging (pinned by the release, docs left
# out by --no-install-recommends): latex-extra is needed by both Sphinx latexpdf and
# the Simulation Manual's preamble, fonts-recommended provides bookman & co.,
# tex-gyre Sphinx's default fonts. ImageMagick is what sphinx.ext.imgconverter
# calls (as `convert`) to turn GIF/SVG images into something pdflatex can embed;
# its SVG coder is in the -extra package, which --no-install-recommends would skip
# (the name carries the ABI version, so it changes with the Ubuntu base).
# rsvg-convert renders the manual's SVG figures to PDF.
FROM base AS pdf

LABEL org.opencontainers.image.description="Toolchain for building the OMNeT++ documentation site, including the PDF documents"

RUN apt-get update && apt-get install -y --no-install-recommends \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
        tex-gyre \
        latexmk \
        librsvg2-bin \
        imagemagick \
        libmagickcore-7.q16-10-extra \
    && rm -rf /var/lib/apt/lists/* /var/log/* /var/cache/* /usr/share/doc/* /usr/share/man/*

# Smoke check, failing the image build if the toolchain is incomplete:
#   - the Simulation Manual's real preamble compiles with a one-line body;
#   - a tiny Sphinx project (site/doc-builder/pdf-smoke) builds to PDF with -W, both
#     with the OMNeT++ guides' fonts and with Sphinx's defaults (as INET uses), and
#     with a GIF and an SVG image, so a missing ImageMagick or coder is an error
#     rather than a silently dropped figure;
#   - rsvg-convert renders an SVG to PDF.
RUN --mount=type=bind,source=manual/usman.tex,target=/tmp/usman.tex \
    --mount=type=bind,source=site/doc-builder/pdf-smoke,target=/tmp/pdf-smoke \
    set -eu; \
    mkdir -p /tmp/smoke/manual; \
    sed '/\\begin{document}/q' /tmp/usman.tex > /tmp/smoke/manual/preamble.tex; \
    printf 'Smoke.\n\\end{document}\n' >> /tmp/smoke/manual/preamble.tex; \
    (cd /tmp/smoke/manual && pdflatex -halt-on-error -interaction=nonstopmode preamble.tex > /dev/null \
        || { tail -40 preamble.log; exit 1; }); \
    test -s /tmp/smoke/manual/preamble.pdf; \
    for fonts in omnetpp default; do \
        cp -r /tmp/pdf-smoke "/tmp/smoke/$fonts"; \
        convert -size 16x16 xc:steelblue "/tmp/smoke/$fonts/smoke.gif"; \
        SMOKE_FONTS=$fonts LATEXMKOPTS=-silent \
            sphinx-build -M latexpdf "/tmp/smoke/$fonts" "/tmp/smoke/$fonts/_build" -W -q; \
        test -s "/tmp/smoke/$fonts/_build/latex/smoke.pdf"; \
    done; \
    rsvg-convert -f pdf -o /tmp/smoke/smoke.pdf /tmp/pdf-smoke/smoke.svg; \
    test -s /tmp/smoke/smoke.pdf; \
    rm -rf /tmp/smoke
